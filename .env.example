# Copy this file to ".env" and fill in your own values. Never commit ".env".

# PayPal Sandbox app client ID (from developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
# PayPal Sandbox app secret (server only, never send it to the browser)
PAYPAL_CLIENT_SECRET=
# PayPal API base URL (Sandbox, no real money)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# AI mode: "mock" (no API key needed) or "gemini"
AI_MODE=mock
# Google Gemini API key (only needed when AI_MODE=gemini)
GEMINI_API_KEY=
# Path to the SQLite database file
SQLITE_PATH=backend/app.db
# Frontend URL allowed by the backend (CORS)
FRONTEND_ORIGIN=http://localhost:5173
